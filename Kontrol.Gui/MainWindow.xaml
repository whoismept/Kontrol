<Window x:Class="Kontrol.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kontrol">

    <Grid>
        <NavigationView x:Name="MainNav"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="True"
                        IsSettingsVisible="True"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        SelectionChanged="OnNavSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavDashboard" Tag="DashboardView">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavFanControl" Tag="FanControlView">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9CA;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavRgb" Tag="RgbView">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavHardware" Tag="FanView">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <InfoBar Grid.Row="0"
                         IsOpen="{Binding HasGlobalAlert, Mode=TwoWay}"
                         Severity="Error"
                         Title="{Binding GlobalAlertTitle}"
                         Message="{Binding GlobalAlertMessage}"
                         IsClosable="True"
                         Margin="32,16,32,0"/>

                <Frame x:Name="ContentFrame" Grid.Row="1"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
