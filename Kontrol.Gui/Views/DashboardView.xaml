<Page x:Class="Kontrol.Views.DashboardView"
      x:Name="DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:Kontrol.Converters"
      xmlns:vm="using:Kontrol.ViewModels">

    <Page.Resources>
        <conv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:ColorToSolidBrushConverter       x:Key="ColorToBrush"/>
        <conv:FanModeToVisibilityConverter     x:Key="FanModeToVis"/>
        <conv:FanModeDisplayConverter          x:Key="FanModeDisplay"/>
        <conv:TempDisplayConverter             x:Key="TempDisplay"/>
        <conv:FloatPercentConverter            x:Key="FloatPercent"/>
        <conv:FloatRoundConverter              x:Key="FloatRound"/>
    </Page.Resources>

    <Grid>
        <!-- Property elements MUST be declared before child elements -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--
            Zero-size collapsed button that hosts the shared quick-color flyout.
            Shown via QuickColorFlyout.ShowAt(targetButton) from code-behind.
            Placed after RowDefinitions to satisfy XAML ordering rules.
        -->
        <Button x:Name="FlyoutAnchor"
                Grid.Row="0" Grid.RowSpan="2"
                Visibility="Collapsed" Width="0" Height="0"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <Button.Flyout>
                <Flyout x:Name="QuickColorFlyout" Placement="Bottom">
                    <StackPanel Width="232" Spacing="12">

                        <TextBlock x:Name="QuickPickTitle"
                                   FontWeight="SemiBold" FontSize="13"/>

                        <!-- 10 preset colors — 2 rows × 5 columns -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                <ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Row="0" Grid.Column="0" Tag="#FFFF0000" Click="OnPresetColorPick"
                                    Width="36" Height="36" Padding="0" CornerRadius="4" Margin="2"
                                    Background="#FFFF0000" BorderBrush="Transparent"/>
                            <Button Grid.Row="0" Grid.Column="1" Tag="#FFFF8800" Click="OnPresetColorPick"
                                    Width="36" Height="36" Padding="0" CornerRadius="4" Margin="2"
                                    Background="#FFFF8800" BorderBrush="Transparent"/>
                            <Button Grid.Row="0" Grid.Column="2" Tag="#FFFFFF00" Click="OnPresetColorPick"
                                    Width="36" Height="36" Padding="0" CornerRadius="4" Margin="2"
                                    Background="#FFFFFF00" BorderBrush="Transparent"/>
                            <Button Grid.Row="0" Grid.Column="3" Tag="#FF00FF00" Click="OnPresetColorPick"
                                    Width="36" Height="36" Padding="0" CornerRadius="4" Margin="2"
                                    Background="#FF00FF00" BorderBrush="Transparent"/>
                            <Button Grid.Row="0" Grid.Column="4" Tag="#FF00FFFF" Click="OnPresetColorPick"
                                    Width="36" Height="36" Padding="0" CornerRadius="4" Margin="2"
                                    Background="#FF00FFFF" BorderBrush="Transparent"/>
                            <Button Grid.Row="1" Grid.Column="0" Tag="#FF0088FF" Click="OnPresetColorPick"
                                    Width="36" Height="36" Padding="0" CornerRadius="4" Margin="2"
                                    Background="#FF0088FF" BorderBrush="Transparent"/>
                            <Button Grid.Row="1" Grid.Column="1" Tag="#FF8800FF" Click="OnPresetColorPick"
                                    Width="36" Height="36" Padding="0" CornerRadius="4" Margin="2"
                                    Background="#FF8800FF" BorderBrush="Transparent"/>
                            <Button Grid.Row="1" Grid.Column="2" Tag="#FFFF00FF" Click="OnPresetColorPick"
                                    Width="36" Height="36" Padding="0" CornerRadius="4" Margin="2"
                                    Background="#FFFF00FF" BorderBrush="Transparent"/>
                            <Button Grid.Row="1" Grid.Column="3" Tag="#FFFFFFFF" Click="OnPresetColorPick"
                                    Width="36" Height="36" Padding="0" CornerRadius="4" Margin="2"
                                    Background="#FFFFFFFF" BorderBrush="Transparent"/>
                            <Button Grid.Row="1" Grid.Column="4" Tag="#FF000000" Click="OnPresetColorPick"
                                    Width="36" Height="36" Padding="0" CornerRadius="4" Margin="2"
                                    Background="#FF1A1A1A" BorderBrush="Transparent"/>
                        </Grid>

                        <!-- Profile list (shown only when profiles exist) -->
                        <StackPanel x:Name="QuickProfileSection" Spacing="6" Visibility="Collapsed">
                            <TextBlock x:Name="QuickProfileLabel" FontSize="11" Opacity="0.6"/>
                            <ComboBox x:Name="QuickProfileCombo"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnQuickProfileSelected"/>
                        </StackPanel>

                        <HyperlinkButton x:Name="QuickOpenRgbLink"
                                         Padding="0" FontSize="11"
                                         Click="OnQuickOpenRgbClick"/>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="32,24,32,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE80F;" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Fan.StatusText}" FontSize="11" Opacity="0.55"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,32">
            <StackPanel>

                <!-- ═══ Hardware fan summary ═══ -->
                <TextBlock x:Name="SecFans" FontSize="11" FontWeight="SemiBold"
                           Opacity="0.5" Margin="0,8,0,10"/>

                <ItemsControl ItemsSource="{Binding Fan.DashDevices}" Margin="0,0,0,28">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DashboardDeviceItem">
                            <Border Margin="0,0,12,12" Padding="20,18" CornerRadius="8"
                                    MinWidth="200" MaxWidth="260"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind TypeLabel}"
                                               FontSize="11" FontWeight="SemiBold" Opacity="0.55"/>
                                    <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Opacity="0.85" Margin="0,2,0,0"/>
                                    <TextBlock Text="{x:Bind MaxTempText, Mode=OneWay}"
                                               FontSize="38" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <Path Width="72" Height="72" Stretch="Uniform"
                                          HorizontalAlignment="Center" Margin="0,16,0,16"
                                          Fill="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          RenderTransformOrigin="0.5,0.5"
                                          Data="F1 M67.29,82.9c-.11,1.3-.26,2.6-.47,3.9-1.43,9-5.79,14.34-8.08,22.17C56,118.45,65.32,122.53,73.27,122A37.63,37.63,0,0,0,85,119a45,45,0,0,0,9.32-5.36c20.11-14.8,16-34.9-6.11-46.36a15,15,0,0,0-4.14-1.4,22,22,0,0,1-6,11.07l0,0A22.09,22.09,0,0,1,67.29,82.9ZM62.4,44.22a17.1,17.1,0,1,1-17.1,17.1,17.1,17.1,0,0,1,17.1-17.1ZM84.06,56.83c1.26.05,2.53.14,3.79.29,9.06,1,14.58,5.16,22.5,7.1,9.6,2.35,13.27-7.17,12.41-15.09a37.37,37.37,0,0,0-3.55-11.57,45.35,45.35,0,0,0-5.76-9.08C97.77,9,77.88,14,67.4,36.63a14.14,14.14,0,0,0-1,2.94A22,22,0,0,1,78,45.68l0,0a22.07,22.07,0,0,1,6,11.13Zm-26.9-17c0-1.6.13-3.21.31-4.81,1-9.07,5.12-14.6,7-22.52C66.86,2.89,57.32-.75,49.41.13A37.4,37.4,0,0,0,37.84,3.7a44.58,44.58,0,0,0-9.06,5.78C9.37,25.2,14.39,45.08,37,55.51a14.63,14.63,0,0,0,3.76,1.14A22.12,22.12,0,0,1,57.16,39.83ZM40.66,65.42a52.11,52.11,0,0,1-5.72-.24c-9.08-.88-14.67-4.92-22.62-6.73C2.68,56.25-.83,65.84.16,73.74A37.45,37.45,0,0,0,3.9,85.25a45.06,45.06,0,0,0,5.91,9c16,19.17,35.8,13.87,45.91-8.91a15.93,15.93,0,0,0,.88-2.66A22.15,22.15,0,0,1,40.66,65.42Z">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="{x:Bind FanAngle, Mode=OneWay}"/>
                                        </Path.RenderTransform>
                                    </Path>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{StaticResource DashMaxRpm}"
                                                       FontSize="10" Opacity="0.5"/>
                                            <TextBlock Text="{x:Bind FanRpmText, Mode=OneWay}"
                                                       FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{StaticResource DashFans}"
                                                       FontSize="10" Opacity="0.5"/>
                                            <TextBlock Text="{x:Bind FanCount, Mode=OneWay}"
                                                       FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ═══ Fan Profile Quick-Switch ═══ -->
                <TextBlock x:Name="SecFanProfiles" FontSize="11" FontWeight="SemiBold"
                           Opacity="0.5" Margin="0,0,0,10"/>

                <Border Margin="0,0,0,28" Padding="16,14" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <ItemsControl ItemsSource="{Binding FanPresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OnDashProfileClick"
                                        Tag="{Binding}"
                                        Padding="16,8"
                                        CornerRadius="8"
                                        MinWidth="100">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE9CA;" FontSize="20"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- ═══ Fan Control ═══ -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SecFanControl" FontSize="11" FontWeight="SemiBold"
                               Opacity="0.5" VerticalAlignment="Center"/>
                    <HyperlinkButton x:Name="BtnGoAdvanced" Grid.Column="1"
                                     Padding="4,0" FontSize="11"
                                     Click="OnGoAdvancedClick"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding FanConfig.FanAssignments}" Margin="0,0,0,28">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,12,12" Padding="18,16" CornerRadius="8"
                                    MinWidth="220" MaxWidth="280"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="10">

                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="13" FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>

                                    <!-- Live stats: RPM · Temp · Target% -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{StaticResource LblRPM}"
                                                       FontSize="9" Opacity="0.5"/>
                                            <TextBlock Text="{Binding CurrentRpm,
                                                                Converter={StaticResource FloatRound}}"
                                                       FontSize="14" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{StaticResource LblTemperature}"
                                                       FontSize="9" Opacity="0.5"/>
                                            <TextBlock Text="{Binding CurrentTempC,
                                                                Converter={StaticResource TempDisplay}}"
                                                       FontSize="14" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{StaticResource LblTarget}"
                                                       FontSize="9" Opacity="0.5"/>
                                            <TextBlock Text="{Binding CurrentTargetPercent,
                                                                Converter={StaticResource FloatPercent}}"
                                                       FontSize="14" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Mode selector -->
                                    <ComboBox ItemsSource="{Binding FanModeValues,
                                                              ElementName=DashboardPage}"
                                              SelectedItem="{Binding Mode, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource FanModeDisplay}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- Manual speed slider (ManualConstant only) -->
                                    <StackPanel Spacing="4"
                                                Visibility="{Binding Mode,
                                                              Converter={StaticResource FanModeToVis},
                                                              ConverterParameter=ManualConstant}">
                                        <TextBlock Text="{StaticResource DashFanSpeed}"
                                                   FontSize="11" Opacity="0.6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="44"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Value="{Binding ManualPercent, Mode=TwoWay}"
                                                    Minimum="0" Maximum="100"
                                                    StepFrequency="1" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ManualPercent,
                                                               Converter={StaticResource FloatPercent}}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ═══ RGB Devices ═══ -->
                <TextBlock x:Name="SecRgb" FontSize="11" FontWeight="SemiBold"
                           Opacity="0.5" Margin="0,0,0,10"/>

                <ProgressRing IsActive="{Binding Rgb.IsLoading}"
                              Width="24" Height="24" HorizontalAlignment="Left"
                              Margin="0,0,0,8"
                              Visibility="{Binding Rgb.IsLoading, Converter={StaticResource BoolToVis}}"/>

                <TextBlock x:Name="NoRgbText" FontSize="13" Opacity="0.55" Margin="0,0,0,8"
                           Visibility="{Binding Rgb.HasDevices, Converter={StaticResource InvBoolToVis}}"/>

                <ItemsControl ItemsSource="{Binding Rgb.Devices}"
                              Visibility="{Binding Rgb.HasDevices, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,12,12" Padding="16,14" CornerRadius="8"
                                    Width="220"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DeviceInfoText}"
                                               FontSize="11" Opacity="0.55" TextWrapping="Wrap"/>
                                    <!-- Current color swatch -->
                                    <Border CornerRadius="4" Height="20"
                                            Background="{Binding CurrentColor,
                                                         Converter={StaticResource ColorToBrush}}"/>
                                    <!-- Change Color button -->
                                    <Button Tag="{Binding}"
                                            Click="OnChangeColorButtonClick"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE790;" FontSize="12"/>
                                            <TextBlock Text="{StaticResource DashRgbChangeColor}"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
