<Page x:Class="Kontrol.Views.FanView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:Kontrol.Converters">

    <Page.Resources>
        <conv:TemperatureToColorConverter x:Key="TempColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="32,24,32,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE950;" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.55"/>
                </StackPanel>
            </StackPanel>
            <Button x:Name="RefreshBtn"
                    Command="{Binding RefreshReadingsCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72C;"/>
            </Button>
        </Grid>

        <!-- Loading indicator -->
        <ProgressRing Grid.Row="1"
                      IsActive="{Binding IsLoading}"
                      Width="32" Height="32"
                      VerticalAlignment="Top" HorizontalAlignment="Center"
                      Margin="0,8,0,0"
                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,24">
            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}">

                <!-- Temperatures -->
                <TextBlock x:Name="SecTemps" FontSize="11" FontWeight="SemiBold"
                           Opacity="0.5" Margin="0,8,0,10"/>

                <ItemsControl ItemsSource="{Binding TemperatureGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Margin="0,0,0,8" IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <FontIcon Glyph="&#xE9CA;" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding HardwareName}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Sensors}" Margin="4,8,4,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="4" Padding="14,10" CornerRadius="8"
                                                    Width="148"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderThickness="0,0,0,2"
                                                    BorderBrush="{Binding Value, Converter={StaticResource TempColor}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SensorName}"
                                                               FontSize="11" Opacity="0.6"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DisplayValue}"
                                                               FontSize="22" FontWeight="Bold"
                                                               Foreground="{Binding Value, Converter={StaticResource TempColor}}"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Fan Speeds -->
                <TextBlock x:Name="SecFans" FontSize="11" FontWeight="SemiBold"
                           Opacity="0.5" Margin="0,24,0,10"/>

                <ItemsControl ItemsSource="{Binding FanGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Margin="0,0,0,8" IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <FontIcon Glyph="&#xE9CA;" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding HardwareName}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Sensors}" Margin="4,8,4,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="4" Padding="14,10" CornerRadius="8"
                                                    Width="160"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <FontIcon Glyph="&#xE9CA;" FontSize="12" Margin="0,0,5,0"
                                                                  VerticalAlignment="Center" Opacity="0.5"/>
                                                        <TextBlock Text="{Binding SensorName}"
                                                                   FontSize="11" Opacity="0.6"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DisplayValue}"
                                                               FontSize="20" FontWeight="Bold"
                                                               Margin="0,4,0,0"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Loads -->
                <TextBlock x:Name="SecLoad" FontSize="11" FontWeight="SemiBold"
                           Opacity="0.5" Margin="0,24,0,10"/>

                <ItemsControl ItemsSource="{Binding LoadGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Margin="0,0,0,8" IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <FontIcon Glyph="&#xE9D9;" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding HardwareName}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Sensors}" Margin="4,8,4,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="56"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SensorName}"
                                                           VerticalAlignment="Center" FontSize="12" Opacity="0.8"/>
                                                <ProgressBar Grid.Column="1"
                                                             Value="{Binding Value}"
                                                             Maximum="100"
                                                             Height="5"
                                                             VerticalAlignment="Center"
                                                             Margin="8,0"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DisplayValue}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
