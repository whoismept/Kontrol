<Page x:Class="Kontrol.Views.FanControlView"
      x:Name="PageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:Kontrol.Converters"
      xmlns:views="using:Kontrol.Views">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:FanModeToVisibilityConverter x:Key="FanModeToVis"/>
        <conv:FanModeDisplayConverter x:Key="FanModeDisplay"/>
        <conv:TempSourceModeDisplayConverter x:Key="TempSourceModeDisplay"/>
        <conv:NullableFloatConverter x:Key="NullableFloat"/>
        <conv:HiddenOpacityConverter x:Key="HiddenOpacity"/>
        <conv:HideToggleTooltipConverter x:Key="HideToggleTooltip"/>
        <conv:TempDisplayConverter x:Key="TempDisplay"/>
        <conv:FanModeTempLabelConverter x:Key="FanModeTempLabel"/>
        <conv:CurveDisplayConverter x:Key="CurveDisplay"/>
        <conv:FloatRoundConverter x:Key="FloatRound"/>
        <conv:FloatPercentConverter x:Key="FloatPercent"/>
        <conv:FloatDegreeConverter x:Key="FloatDegree"/>
        <conv:IntMsConverter x:Key="IntMs"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="32,24,32,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE9CA;" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.55"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                <Button Command="{Binding ToggleShowHiddenCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7B3;" FontSize="14"/>
                        <TextBlock Text="{Binding ShowHiddenButtonText}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ImportConfigCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B5;" FontSize="14"/>
                        <TextBlock x:Name="BtnImportText"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportConfigCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEDE1;" FontSize="14"/>
                        <TextBlock x:Name="BtnExportText"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RescanFansCommand}" x:Name="BtnRescan"/>
                <Button Command="{Binding SaveConfigCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                        <TextBlock x:Name="BtnSaveText"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Pivot Grid.Row="1" Margin="32,0,32,24">

            <!-- TAB 1: Fans -->
            <PivotItem x:Name="TabFans">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding FanAssignments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="18" CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <!-- Fan header -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Visibility="{Binding IsRenaming, Converter={StaticResource InvBoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                                               Opacity="{Binding IsHidden, Converter={StaticResource HiddenOpacity}}"/>
                                                    <Border Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}"
                                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                            CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{StaticResource LblHidden}" FontSize="10" Opacity="0.55"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding HardwareName}" FontSize="11" Opacity="0.5" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}">
                                                <TextBox Text="{Binding CustomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="{Binding FanName}"
                                                         FontSize="14" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                <Button Visibility="{Binding IsRenaming, Converter={StaticResource InvBoolToVis}}"
                                                        Command="{Binding StartRenameCommand}" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE8AC;" FontSize="14"/>
                                                </Button>
                                                <Button Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding ConfirmRenameCommand}"
                                                        Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="14"/>
                                                </Button>
                                                <Button Command="{Binding ToggleHiddenCommand}"
                                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <FontIcon Glyph="&#xED1A;" FontSize="14"/>
                                                </Button>

                                                <!-- Live stats pill -->
                                                <Border Padding="12,8" CornerRadius="8"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <TextBlock Text="RPM" FontSize="9" Opacity="0.5" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding CurrentRpm, Converter={StaticResource FloatRound}}"
                                                                       FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"
                                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                        </StackPanel>

                                                        <Border Width="1" VerticalAlignment="Stretch"
                                                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,0,16,0"/>

                                                        <StackPanel VerticalAlignment="Center" Width="72" Margin="0,0,16,0">
                                                            <TextBlock Text="Target" FontSize="9" Opacity="0.5" HorizontalAlignment="Center"/>
                                                            <ProgressBar Value="{Binding CurrentTargetPercent, Mode=OneWay}"
                                                                         Maximum="100" Height="5" Margin="0,3,0,2"/>
                                                            <TextBlock Text="{Binding CurrentTargetPercent, Converter={StaticResource FloatPercent}}"
                                                                       FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                        </StackPanel>

                                                        <Border Width="1" VerticalAlignment="Stretch"
                                                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,0,16,0"/>

                                                        <StackPanel VerticalAlignment="Center" MinWidth="44">
                                                            <TextBlock Text="{Binding Mode, Converter={StaticResource FanModeTempLabel}}"
                                                                       FontSize="9" Opacity="0.5" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding CurrentTempC, Converter={StaticResource TempDisplay}}"
                                                                       FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"
                                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Mode selector -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{StaticResource LblMode}" FontWeight="SemiBold" FontSize="12"
                                                       VerticalAlignment="Center" Opacity="0.8"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding AllFanModes}"
                                                      SelectedItem="{Binding Mode, Mode=TwoWay}"
                                                      Width="220" HorizontalAlignment="Left">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource FanModeDisplay}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>

                                        <!-- ManualConstant -->
                                        <StackPanel Visibility="{Binding Mode, Converter={StaticResource FanModeToVis}, ConverterParameter=ManualConstant}">
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="52"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{StaticResource LblSpeed}" FontSize="12" VerticalAlignment="Center" Opacity="0.8"/>
                                                <Slider Grid.Column="1"
                                                        Value="{Binding ManualPercent, Mode=TwoWay}"
                                                        Minimum="0" Maximum="100" TickFrequency="5" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding ManualPercent, Converter={StaticResource FloatPercent}}"
                                                           HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Curve mode -->
                                        <StackPanel Visibility="{Binding Mode, Converter={StaticResource FanModeToVis}, ConverterParameter=Curve}">
                                            <Grid Margin="0,4,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Text="{StaticResource LblCurve}" FontSize="12" Opacity="0.8" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Row="0" Grid.Column="1"
                                                          ItemsSource="{Binding AvailableCurves}"
                                                          SelectedItem="{Binding SelectedCurve, Mode=TwoWay}"
                                                          DisplayMemberPath="Name"
                                                          Width="220" HorizontalAlignment="Left"/>

                                                <TextBlock Grid.Row="2" Text="{StaticResource LblSource}" FontSize="12" Opacity="0.8" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Row="2" Grid.Column="1"
                                                          ItemsSource="{Binding AvailableSources}"
                                                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                                          DisplayMemberPath="Name"
                                                          Width="220" HorizontalAlignment="Left"/>

                                                <TextBlock Grid.Row="4" Text="{StaticResource LblMinMax}" FontSize="12" Opacity="0.8" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                    <Slider Value="{Binding MinPercent, Mode=TwoWay}" Minimum="0" Maximum="100"
                                                            Width="110" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding MinPercent, Converter={StaticResource FloatPercent}}"
                                                               VerticalAlignment="Center" FontSize="12"/>
                                                    <TextBlock Text="—" VerticalAlignment="Center" Opacity="0.5"/>
                                                    <Slider Value="{Binding MaxPercent, Mode=TwoWay}" Minimum="0" Maximum="100"
                                                            Width="110" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding MaxPercent, Converter={StaticResource FloatPercent}}"
                                                               VerticalAlignment="Center" FontSize="12"/>
                                                </StackPanel>

                                                <TextBlock Grid.Row="6" Text="{StaticResource LblLive}" FontSize="12" Opacity="0.8" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="6" Grid.Column="1"
                                                           Text="{Binding LiveTempDisplay}"
                                                           FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Off hint -->
                                        <TextBlock Text="{StaticResource HintFanOff}"
                                                   Visibility="{Binding Mode, Converter={StaticResource FanModeToVis}, ConverterParameter=Off}"
                                                   FontSize="11" Opacity="0.6" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </PivotItem>

            <!-- TAB 2: Curves -->
            <PivotItem x:Name="TabCurves">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListView ItemsSource="{Binding Curves}"
                                  SelectedItem="{Binding SelectedCurve, Mode=TwoWay}"
                                  Background="Transparent" BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,6">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding Converter={StaticResource CurveDisplay}}"
                                                   FontSize="11" Opacity="0.55"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                            <Button Command="{Binding AddCurveCommand}" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                    <TextBlock x:Name="BtnAddCurveText"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteCurveCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xEA1F;" FontSize="12"/>
                                    <TextBlock x:Name="BtnDeleteCurveText"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedCurve}">
                            <TextBlock x:Name="HintSelectCurveText"
                                       Visibility="{Binding DataContext.HasSelectedCurve, ElementName=PageRoot, Converter={StaticResource InvBoolToVis}}"
                                       Opacity="0.5" Margin="0,24,0,0" HorizontalAlignment="Center"/>

                            <Border Padding="12" Margin="0,0,0,10" CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Visibility="{Binding DataContext.HasSelectedCurve, ElementName=PageRoot, Converter={StaticResource BoolToVis}}">
                                <views:CurveGraphEditor Height="200"
                                    Curve="{Binding DataContext.SelectedCurve, ElementName=PageRoot}"/>
                            </Border>

                            <Border Padding="18" Margin="0,0,0,10" CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Visibility="{Binding DataContext.HasSelectedCurve, ElementName=PageRoot, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblNameCurveText" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblTypeCurveText" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding DataContext.CurveTypes, ElementName=PageRoot}"
                                                  SelectedItem="{Binding Type, Mode=TwoWay}" Width="160" HorizontalAlignment="Left"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblHysteresisText" FontSize="12" VerticalAlignment="Center" Opacity="0.8"/>
                                        <Slider Grid.Column="1" Value="{Binding HysteresisC, Mode=TwoWay}"
                                                Minimum="0" Maximum="10" TickFrequency="0.5" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding HysteresisC, Converter={StaticResource FloatDegree}}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblResponseText" FontSize="12" VerticalAlignment="Center" Opacity="0.8"/>
                                        <Slider Grid.Column="1" Value="{Binding ResponseTimeMs, Mode=TwoWay}"
                                                Minimum="0" Maximum="5000" TickFrequency="100" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ResponseTimeMs, Converter={StaticResource IntMs}}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Padding="18" CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Visibility="{Binding DataContext.HasSelectedCurve, ElementName=PageRoot, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Name="SecCurvePointsText" FontWeight="SemiBold" FontSize="13"/>
                                        <Button HorizontalAlignment="Right"
                                                Command="{Binding DataContext.AddCurvePointCommand, ElementName=PageRoot}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                                <TextBlock x:Name="BtnAddPointText"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblTempCText" FontWeight="SemiBold" FontSize="11" Opacity="0.6"/>
                                        <TextBlock Grid.Column="1" x:Name="LblSpeedPctText" FontWeight="SemiBold" FontSize="11" Opacity="0.6"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Points}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding TempC, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             Width="96" HorizontalAlignment="Left"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding Percent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             Width="96" HorizontalAlignment="Left"/>
                                                    <Button Grid.Column="2" Tag="{Binding}" Click="OnRemoveCurvePointClick">
                                                        <FontIcon Glyph="&#xEA1F;" FontSize="14"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <!-- TAB 3: Temperature Sources -->
            <PivotItem x:Name="TabTempSources">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListView ItemsSource="{Binding TempSources}"
                                  SelectedItem="{Binding SelectedTempSource, Mode=TwoWay}"
                                  Background="Transparent" BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,6">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding Mode, Converter={StaticResource TempSourceModeDisplay}}"
                                                   FontSize="11" Opacity="0.55"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                            <Button Command="{Binding AddTempSourceCommand}" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                    <TextBlock x:Name="BtnAddSourceText"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteTempSourceCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xEA1F;" FontSize="12"/>
                                    <TextBlock x:Name="BtnDeleteSourceText"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedTempSource}">
                            <Border Padding="18" Margin="0,0,0,10" CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblNameSrcText" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblModeSrcText" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding DataContext.TempSourceModes, ElementName=PageRoot}"
                                                  SelectedItem="{Binding Mode, Mode=TwoWay}" Width="190" HorizontalAlignment="Left">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource TempSourceModeDisplay}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Padding="18" CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Name="SecSensorFiltersText" FontWeight="SemiBold" FontSize="13"/>
                                        <Button HorizontalAlignment="Right"
                                                Command="{Binding DataContext.AddSensorRefCommand, ElementName=PageRoot}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                                <TextBlock x:Name="BtnAddFilterText"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="HintWildcardText" FontSize="11" Opacity="0.55" Margin="0,0,0,8"/>

                                    <ItemsControl ItemsSource="{Binding SensorRefs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding HardwareName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             PlaceholderText="*" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="2"
                                                             Text="{Binding SensorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             PlaceholderText="*" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="3" Margin="4,0,0,0"
                                                            Tag="{Binding}" Click="OnRemoveSensorRefClick">
                                                        <FontIcon Glyph="&#xEA1F;" FontSize="14"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="SecDetectedSensorsText" FontWeight="SemiBold"
                                               FontSize="12" Margin="0,16,0,6"/>
                                    <ItemsControl ItemsSource="{Binding DataContext.AvailableSensors, ElementName=PageRoot}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" Opacity="0.65" Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
