<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
    <RootNamespace>Kontrol.Rgb</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built-in HID device definitions (embedded as resources) -->
    <EmbeddedResource Include="Definitions\Builtin\*.json" />
  </ItemGroup>
</Project>
