<ui:FluentWindow x:Class="Kontrol.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:Kontrol.Views"
                 Title="Kontrol"
                 Width="1280" Height="800"
                 MinWidth="960" MinHeight="580"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 Icon="/Resources/app.ico"
                 TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <ui:ImageIcon Source="/Resources/app.ico" Width="18" Height="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Kontrol" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- NavigationView -->
        <ui:NavigationView x:Name="MainNav"
                           Grid.Row="1"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           PaneDisplayMode="LeftFluent"
                           OpenPaneLength="220">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{DynamicResource NavHardware}"
                                       Icon="{ui:SymbolIcon Gauge24}"
                                       TargetPageType="{x:Type views:FanView}"/>
                <ui:NavigationViewItem Content="{DynamicResource NavFanControl}"
                                       Icon="{ui:SymbolIcon WeatherBlowingSnow24}"
                                       TargetPageType="{x:Type views:FanControlView}"/>
                <ui:NavigationViewItem Content="{DynamicResource NavRGB}"
                                       Icon="{ui:SymbolIcon Color24}"
                                       TargetPageType="{x:Type views:RgbView}"/>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{DynamicResource NavSettings}"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type views:SettingsView}"/>
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.PaneFooter>
                <ui:Card Margin="8,0,8,8" Padding="14,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Temperature24" FontSize="12" Margin="0,0,6,0"
                                           VerticalAlignment="Center" Opacity="0.6"/>
                            <TextBlock Text="{DynamicResource StatCpu}" FontSize="10" Opacity="0.6"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Fan.MaxCpuTempText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Temperature24" FontSize="12" Margin="0,0,6,0"
                                           VerticalAlignment="Center" Opacity="0.6"/>
                            <TextBlock Text="{DynamicResource StatGpu}" FontSize="10" Opacity="0.6"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Fan.MaxGpuTempText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="WeatherBlowingSnow24" FontSize="12" Margin="0,0,6,0"
                                           VerticalAlignment="Center" Opacity="0.6"/>
                            <TextBlock Text="{DynamicResource StatFan}" FontSize="10" Opacity="0.6"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Fan.MaxFanRpmText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </ui:NavigationView.PaneFooter>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
