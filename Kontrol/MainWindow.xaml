<ui:FluentWindow x:Class="Kontrol.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:Kontrol.Views"
                 Title="Kontrol — Fan + RGB Dashboard"
                 Width="1200" Height="780"
                 MinWidth="900" MinHeight="540"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 Icon="/Resources/app.ico"
                 TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="GroupName" Value="MainNav"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="6"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Bg" Property="TextElement.Foreground"
                                        Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Bg" Property="TextElement.Foreground"
                                        Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="Kontrol"
                     ShowMaximize="True"
                     ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Resources/app.ico" Width="20" Height="20"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Sidebar + Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <DockPanel Grid.Column="0" LastChildFill="True">
                <Border DockPanel.Dock="Bottom" Margin="8,4,8,12">
                    <RadioButton x:Name="SettingsNav" Style="{StaticResource NavButton}"
                                 Tag="3" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ayarlar" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </RadioButton>
                </Border>
                <StackPanel Margin="0,16,0,0">
                    <RadioButton x:Name="HardwareNav" Style="{StaticResource NavButton}"
                                 Tag="0" IsChecked="True" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Gauge24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Donanım" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FansNav" Style="{StaticResource NavButton}"
                                 Tag="1" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="WeatherBlowingSnow24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Fan Kontrolü" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RgbNav" Style="{StaticResource NavButton}"
                                 Tag="2" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Color24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="RGB" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>

            <!-- Content panels -->
            <Border Grid.Column="1"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    CornerRadius="8,0,0,0">
                <Grid>
                    <views:FanView x:Name="HardwareViewPanel" DataContext="{Binding Fan}"/>
                    <views:FanControlView x:Name="FansViewPanel" DataContext="{Binding FanConfig}" Visibility="Collapsed"/>
                    <views:RgbView x:Name="RgbViewPanel" DataContext="{Binding Rgb}" Visibility="Collapsed"/>
                    <views:SettingsView x:Name="SettingsViewPanel" DataContext="{Binding Settings}" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
