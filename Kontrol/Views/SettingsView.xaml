<UserControl x:Class="Kontrol.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="32,24,32,16" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="Settings24" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock Text="{DynamicResource PageSettings}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,24">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                <!-- Hardware monitoring -->
                <TextBlock Text="{DynamicResource SecHardwareMonitoring}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <ui:Card Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LblSensorInterval}"
                                   FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource LblSensorIntervalHint}"
                                   FontSize="11" Opacity="0.7" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider Value="{Binding PollingIntervalMs}"
                                    Minimum="500" Maximum="10000"
                                    TickFrequency="500" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PollingIntervalMs}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- App behavior -->
                <TextBlock Text="{DynamicResource SecAppBehavior}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <ui:Card Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LblMinimizeToTray}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{DynamicResource LblMinimizeToTrayHint}"
                                           FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray}"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LblStartMinimized}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{DynamicResource LblStartMinimizedHint}"
                                           FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding StartMinimized}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LblLaunchOnStartup}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{DynamicResource LblLaunchOnStartupHint}"
                                           FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchOnWindowsStartup}"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Temp Alerts -->
                <TextBlock Text="{DynamicResource SecTempAlerts}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <ui:Card Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LblEnableAlerts}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{DynamicResource LblEnableAlertsHint}"
                                           FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding TempAlertsEnabled}"/>
                        </Grid>

                        <TextBlock Text="{DynamicResource LblAlertThreshold}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider Value="{Binding TempAlertThresholdC}"
                                    Minimum="50" Maximum="110"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:F0}°C">
                                        <Binding Path="TempAlertThresholdC"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- OpenRGB -->
                <TextBlock Text="{DynamicResource SecOpenRGB}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <ui:Card Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LblOpenRGBServer}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{DynamicResource LblOpenRGBServerHint}"
                                           FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding OpenRgbEnabled}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource LblServer}" FontSize="13" VerticalAlignment="Center"/>
                            <ui:TextBox Grid.Column="1"
                                        Text="{Binding OpenRgbHost, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="127.0.0.1"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource LblPort}" FontSize="13" VerticalAlignment="Center"/>
                            <ui:TextBox Grid.Column="1"
                                        Text="{Binding OpenRgbPort, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="6742" Width="120" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource LblClient}" FontSize="13" VerticalAlignment="Center"/>
                            <ui:TextBox Grid.Column="1"
                                        Text="{Binding OpenRgbClientName, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Kontrol"/>
                        </Grid>

                        <TextBlock Text="{DynamicResource LblOpenRGBNote}"
                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Appearance -->
                <TextBlock Text="{DynamicResource SecAppearance}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <ui:Card Padding="20" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LblTheme}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{DynamicResource LblThemeHint}"
                                       FontSize="11" Opacity="0.7"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  Width="140"/>
                    </Grid>
                </ui:Card>

                <ui:Card Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LblLanguage}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{DynamicResource LblLanguageHint}"
                                       FontSize="11" Opacity="0.7"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  Width="160"/>
                    </Grid>
                </ui:Card>

                <!-- Save -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SaveStatusText}" FontSize="12" Opacity="0.6"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ui:Button Command="{Binding SaveCommand}"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Save24}"
                               Content="{DynamicResource BtnSave}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
