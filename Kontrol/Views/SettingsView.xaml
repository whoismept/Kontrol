<UserControl x:Class="Kontrol.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="32,24,32,16" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="Settings24" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock Text="Ayarlar" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,24">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                <!-- Hardware monitoring -->
                <TextBlock Text="Donanım İzleme" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <ui:Card Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Sensör Güncelleme Aralığı (ms)"
                                   FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                        <TextBlock Text="Düşük değer daha akıcı ama daha çok CPU kullanır."
                                   FontSize="11" Opacity="0.7" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider Value="{Binding PollingIntervalMs}"
                                    Minimum="500" Maximum="10000"
                                    TickFrequency="500" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PollingIntervalMs}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- App behavior -->
                <TextBlock Text="Uygulama Davranışı" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <ui:Card Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Tray'e küçült" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Pencere kapatıldığında sistem tepsisinde kal"
                                           FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray}"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Küçültülmüş başlat" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Uygulama açıldığında sistem tepsisinden başlasın"
                                           FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding StartMinimized}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Windows ile başlat" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Oturum açıldığında otomatik çalıştır"
                                           FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchOnWindowsStartup}"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Temp Alerts -->
                <TextBlock Text="Sıcaklık Uyarıları" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <ui:Card Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Sıcaklık uyarılarını etkinleştir" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Eşik aşıldığında sistem tepsisinden bildirim göster"
                                           FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding TempAlertsEnabled}"/>
                        </Grid>

                        <TextBlock Text="Uyarı Eşiği (°C)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider Value="{Binding TempAlertThresholdC}"
                                    Minimum="50" Maximum="110"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:F0}°C">
                                        <Binding Path="TempAlertThresholdC"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- OpenRGB -->
                <TextBlock Text="OpenRGB Entegrasyonu" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <ui:Card Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="OpenRGB SDK Sunucusu" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="OpenRGB uygulamasının SDK Server modunu kullanarak tüm cihazları kontrol et"
                                           FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding OpenRgbEnabled}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sunucu:" FontSize="13" VerticalAlignment="Center"/>
                            <ui:TextBox Grid.Column="1"
                                        Text="{Binding OpenRgbHost, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="127.0.0.1"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Port:" FontSize="13" VerticalAlignment="Center"/>
                            <ui:TextBox Grid.Column="1"
                                        Text="{Binding OpenRgbPort, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="6742" Width="120" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="İstemci:" FontSize="13" VerticalAlignment="Center"/>
                            <ui:TextBox Grid.Column="1"
                                        Text="{Binding OpenRgbClientName, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Kontrol"/>
                        </Grid>

                        <TextBlock Text="Not: OpenRGB uygulamasında SDK Server'ı etkinleştirmeniz gerekir. Değişiklik için uygulamayı yeniden başlatın."
                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Appearance -->
                <TextBlock Text="Görünüm" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <ui:Card Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tema" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Koyu, Açık veya Sistem temasını seçin"
                                       FontSize="11" Opacity="0.7"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  Width="140"/>
                    </Grid>
                </ui:Card>

                <!-- Save -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SaveStatusText}" FontSize="12" Opacity="0.6"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ui:Button Command="{Binding SaveCommand}"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Save24}"
                               Content="Kaydet"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
