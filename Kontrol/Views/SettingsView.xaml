<UserControl x:Class="Kontrol.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="32,24,32,16" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="Settings24" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,24">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                <!-- Hardware monitoring -->
                <TextBlock Text="Hardware Monitoring" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <ui:Card Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Sensor Update Interval (ms)"
                                   FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                        <TextBlock Text="Lower values feel smoother but use more CPU."
                                   FontSize="11" Opacity="0.7" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider Value="{Binding PollingIntervalMs}"
                                    Minimum="500" Maximum="10000"
                                    TickFrequency="500" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PollingIntervalMs}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- App behavior -->
                <TextBlock Text="Application Behavior" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <ui:Card Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Minimize to tray" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Keep running in system tray when window is closed"
                                           FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray}"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Start minimized" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Start in system tray when app launches"
                                           FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding StartMinimized}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Launch with Windows" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Run automatically at sign in"
                                           FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchOnWindowsStartup}"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Temp Alerts -->
                <TextBlock Text="Temperature Alerts" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <ui:Card Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Enable temperature alerts" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Show tray notification when threshold is exceeded"
                                           FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding TempAlertsEnabled}"/>
                        </Grid>

                        <TextBlock Text="Alert Threshold (°C)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider Value="{Binding TempAlertThresholdC}"
                                    Minimum="50" Maximum="110"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:F0}°C">
                                        <Binding Path="TempAlertThresholdC"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- OpenRGB -->
                <TextBlock Text="OpenRGB Integration" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <ui:Card Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="OpenRGB SDK Server" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Control all devices using OpenRGB SDK Server mode"
                                           FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding OpenRgbEnabled}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Host:" FontSize="13" VerticalAlignment="Center"/>
                            <ui:TextBox Grid.Column="1"
                                        Text="{Binding OpenRgbHost, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="127.0.0.1"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Port:" FontSize="13" VerticalAlignment="Center"/>
                            <ui:TextBox Grid.Column="1"
                                        Text="{Binding OpenRgbPort, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="6742" Width="120" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Client:" FontSize="13" VerticalAlignment="Center"/>
                            <ui:TextBox Grid.Column="1"
                                        Text="{Binding OpenRgbClientName, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Kontrol"/>
                        </Grid>

                        <TextBlock Text="Note: Enable SDK Server in OpenRGB. Restart the app for changes to take effect."
                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Appearance -->
                <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <ui:Card Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Choose Dark, Light, or System theme"
                                       FontSize="11" Opacity="0.7"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  Width="140"/>
                    </Grid>
                </ui:Card>

                <!-- Save -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SaveStatusText}" FontSize="12" Opacity="0.6"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ui:Button Command="{Binding SaveCommand}"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Save24}"
                               Content="Save"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
