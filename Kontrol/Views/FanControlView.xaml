<UserControl x:Class="Kontrol.Views.FanControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:Kontrol.Converters"
             xmlns:vm="clr-namespace:Kontrol.ViewModels"
             xmlns:fan="clr-namespace:Kontrol.Models.Fan"
             xmlns:views="clr-namespace:Kontrol.Views">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:FanModeToVisibilityConverter x:Key="FanModeToVis"/>
        <conv:FanModeDisplayConverter x:Key="FanModeDisplay"/>
        <conv:TempSourceModeDisplayConverter x:Key="TempSourceModeDisplay"/>
        <conv:NullableFloatConverter x:Key="NullableFloat"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="32,24,32,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="WeatherBlowingSnow24" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Fan Kontrolü" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Sabit hız, sıcaklığa göre eğri veya BIOS otomatiği ile fan yönetimi"
                               FontSize="12" Opacity="0.7"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button Command="{Binding ImportConfigCommand}"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon ArrowImport24}"
                           Content="İçe Aktar"
                           Margin="0,0,4,0"/>
                <ui:Button Command="{Binding ExportConfigCommand}"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon ArrowExport24}"
                           Content="Dışa Aktar"
                           Margin="0,0,8,0"/>
                <ui:Button Command="{Binding RescanFansCommand}"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Content="Yeniden Tara"
                           Margin="0,0,8,0"/>
                <ui:Button Command="{Binding SaveConfigCommand}"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Save24}"
                           Content="Kaydet"/>
            </StackPanel>
        </Grid>

        <!-- Tabbed content -->
        <TabControl Grid.Row="1" Margin="32,0,32,16">

            <!-- TAB 1: Fanlar -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="WeatherBlowingSnow24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Fanlar" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding FanAssignments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FanAssignmentViewModel}">
                                <ui:Card Margin="0,0,0,12" Padding="20">
                                    <StackPanel>
                                        <!-- Fan header row -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FanName}" FontWeight="SemiBold" FontSize="15"/>
                                                <TextBlock Text="{Binding HardwareName}" FontSize="11" Opacity="0.6" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- RPM gauge area -->
                                            <Border Grid.Column="1" Padding="12,8" CornerRadius="8"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- RPM -->
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="RPM" FontSize="9" Opacity="0.5" HorizontalAlignment="Center"/>
                                                        <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0:F0}">
                                                                    <Binding Path="CurrentRpm"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Divider -->
                                                    <Border Grid.Column="1" Width="1" VerticalAlignment="Stretch"
                                                            Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                                                    <!-- Speed bar -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="80">
                                                        <TextBlock Text="Hedef" FontSize="9" Opacity="0.5" HorizontalAlignment="Center"/>
                                                        <ProgressBar Value="{Binding CurrentTargetPercent, Mode=OneWay}"
                                                                     Maximum="100" Height="6" Margin="0,4,0,2"/>
                                                        <TextBlock FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0:F0}%">
                                                                    <Binding Path="CurrentTargetPercent"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Divider -->
                                                    <Border Grid.Column="3" Width="1" VerticalAlignment="Stretch"
                                                            Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                                                    <!-- Temp (curve mode only) -->
                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" MinWidth="48">
                                                        <TextBlock Text="Sıcaklık" FontSize="9" Opacity="0.5" HorizontalAlignment="Center"/>
                                                        <TextBlock FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0:F0}°">
                                                                    <Binding Path="CurrentTempC"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- Mode selector -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Mod:" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding DataContext.FanModes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Mode}"
                                                      Width="240" HorizontalAlignment="Left">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource FanModeDisplay}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>

                                        <!-- ManualConstant controls -->
                                        <StackPanel Visibility="{Binding Mode, Converter={StaticResource FanModeToVis}, ConverterParameter=ManualConstant}">
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Hız:" FontSize="13" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1"
                                                        Value="{Binding ManualPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Minimum="0" Maximum="100"
                                                        TickFrequency="5"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" HorizontalAlignment="Right"
                                                           FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:F0}%">
                                                            <Binding Path="ManualPercent"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Curve controls -->
                                        <StackPanel Visibility="{Binding Mode, Converter={StaticResource FanModeToVis}, ConverterParameter=Curve}">
                                            <Grid Margin="0,4,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Text="Eğri:" FontSize="13" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Row="0" Grid.Column="1"
                                                          ItemsSource="{Binding DataContext.Curves, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedValue="{Binding CurveId}"
                                                          SelectedValuePath="Id"
                                                          DisplayMemberPath="Name"
                                                          Width="240" HorizontalAlignment="Left"/>

                                                <TextBlock Grid.Row="2" Text="Kaynak:" FontSize="13" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Row="2" Grid.Column="1"
                                                          ItemsSource="{Binding DataContext.TempSources, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedValue="{Binding TempSourceId}"
                                                          SelectedValuePath="Id"
                                                          DisplayMemberPath="Name"
                                                          Width="240" HorizontalAlignment="Left"/>

                                                <TextBlock Grid.Row="4" Text="Min/Max %:" FontSize="13" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                                    <Slider Value="{Binding MinPercent}" Minimum="0" Maximum="100"
                                                            Width="120" VerticalAlignment="Center"/>
                                                    <TextBlock VerticalAlignment="Center" Margin="8,0">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0:F0}%">
                                                                <Binding Path="MinPercent"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock Text="—" VerticalAlignment="Center" Margin="4,0"/>
                                                    <Slider Value="{Binding MaxPercent}" Minimum="0" Maximum="100"
                                                            Width="120" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                    <TextBlock VerticalAlignment="Center" Margin="8,0">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0:F0}%">
                                                                <Binding Path="MaxPercent"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>

                                                <TextBlock Grid.Row="6" Text="Sıcaklık:" FontSize="13" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                <TextBlock Grid.Row="6" Grid.Column="1"
                                                           FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:F1}°C → {1:F0}%">
                                                            <Binding Path="CurrentTempC"/>
                                                            <Binding Path="CurrentTargetPercent"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Off mode note -->
                                        <TextBlock Visibility="{Binding Mode, Converter={StaticResource FanModeToVis}, ConverterParameter=Off}"
                                                   Text="Fan kapatıldı — donanımınız 0 RPM desteklemiyorsa minimum hızda dönebilir."
                                                   FontSize="11" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Eğriler -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DataLine24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Eğriler" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Curve list -->
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:Button Command="{Binding AddCurveCommand}" Icon="{ui:SymbolIcon Add24}"
                                       Content="Ekle" Appearance="Primary" Margin="0,0,4,0"/>
                            <ui:Button Command="{Binding DeleteCurveCommand}" Icon="{ui:SymbolIcon Delete24}"
                                       Content="Sil" Appearance="Secondary"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Curves}"
                                 SelectedItem="{Binding SelectedCurve}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,6">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock FontSize="11" Opacity="0.6">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} nokta • {1}">
                                                    <Binding Path="Points.Count"/>
                                                    <Binding Path="Type"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Curve editor -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedCurve}">
                            <!-- Graph preview -->
                            <ui:Card Padding="12" Margin="0,0,0,12">
                                <views:CurveGraphEditor Height="220"
                                    Curve="{Binding DataContext.SelectedCurve, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </ui:Card>

                            <ui:Card Padding="20" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ad:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ui:TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tür:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding DataContext.CurveTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Type}" Width="180" HorizontalAlignment="Left"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Hysteresis:" FontSize="12" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" Value="{Binding HysteresisC}"
                                                Minimum="0" Maximum="10" TickFrequency="0.5"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:F1}°C">
                                                    <Binding Path="HysteresisC"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tepki:" FontSize="12" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" Value="{Binding ResponseTimeMs}"
                                                Minimum="0" Maximum="5000" TickFrequency="100"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}ms">
                                                    <Binding Path="ResponseTimeMs"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>

                            <!-- Curve points -->
                            <ui:Card Padding="20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Eğri Noktaları" FontWeight="SemiBold" FontSize="14"/>
                                        <ui:Button HorizontalAlignment="Right"
                                                   Command="{Binding DataContext.AddCurvePointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Icon="{ui:SymbolIcon Add24}" Content="Nokta Ekle"
                                                   Appearance="Secondary"/>
                                    </Grid>

                                    <!-- Points header -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Sıcaklık (°C)" FontWeight="SemiBold" FontSize="11" Opacity="0.7"/>
                                        <TextBlock Grid.Column="1" Text="Hız (%)" FontWeight="SemiBold" FontSize="11" Opacity="0.7"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Points}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBox Text="{Binding TempC, UpdateSourceTrigger=LostFocus}"
                                                                Width="100" HorizontalAlignment="Left"/>
                                                    <ui:TextBox Grid.Column="1" Text="{Binding Percent, UpdateSourceTrigger=LostFocus}"
                                                                Width="100" HorizontalAlignment="Left"/>
                                                    <ui:Button Grid.Column="2"
                                                               Command="{Binding DataContext.RemoveCurvePointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}"
                                                               Icon="{ui:SymbolIcon Delete24}"
                                                               Appearance="Secondary"
                                                               ToolTip="Noktayı sil"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 3: Sıcaklık Kaynakları -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Temperature24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Sıcaklık Kaynakları" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Source list -->
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:Button Command="{Binding AddTempSourceCommand}" Icon="{ui:SymbolIcon Add24}"
                                       Content="Ekle" Appearance="Primary" Margin="0,0,4,0"/>
                            <ui:Button Command="{Binding DeleteTempSourceCommand}" Icon="{ui:SymbolIcon Delete24}"
                                       Content="Sil" Appearance="Secondary"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding TempSources}"
                                 SelectedItem="{Binding SelectedTempSource}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,6">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding Mode, Converter={StaticResource TempSourceModeDisplay}}"
                                                   FontSize="11" Opacity="0.6"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Source editor -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedTempSource}">
                            <ui:Card Padding="20" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ad:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ui:TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Mod:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding DataContext.TempSourceModes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Mode}" Width="200" HorizontalAlignment="Left">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource TempSourceModeDisplay}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>

                            <!-- Sensor refs -->
                            <ui:Card Padding="20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Sensör Filtreleri" FontWeight="SemiBold" FontSize="14"/>
                                        <ui:Button HorizontalAlignment="Right"
                                                   Command="{Binding DataContext.AddSensorRefCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Icon="{ui:SymbolIcon Add24}" Content="Filtre Ekle"
                                                   Appearance="Secondary"/>
                                    </Grid>
                                    <TextBlock Text="Wildcard destekler: *CPU*, *GPU*, * (tümü)"
                                               FontSize="11" Opacity="0.6" Margin="0,0,0,8"/>

                                    <ItemsControl ItemsSource="{Binding SensorRefs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBox Text="{Binding HardwareName, UpdateSourceTrigger=PropertyChanged}"
                                                                PlaceholderText="Donanım adı (*CPU*)"
                                                                VerticalAlignment="Center"/>
                                                    <ui:TextBox Grid.Column="2" Text="{Binding SensorName, UpdateSourceTrigger=PropertyChanged}"
                                                                PlaceholderText="Sensör adı (*)"
                                                                VerticalAlignment="Center"/>
                                                    <ui:Button Grid.Column="3" Margin="4,0,0,0"
                                                               Command="{Binding DataContext.RemoveSensorRefCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}"
                                                               Icon="{ui:SymbolIcon Delete24}"
                                                               Appearance="Secondary"
                                                               ToolTip="Filtreyi sil"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Available sensors info -->
                                    <TextBlock Text="Bulunan Sıcaklık Sensörleri:" FontWeight="SemiBold"
                                               FontSize="12" Margin="0,16,0,4"/>
                                    <ItemsControl ItemsSource="{Binding DataContext.AvailableSensors, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" Opacity="0.7" Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status -->
        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Padding="32,8">
            <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.7"/>
        </Border>
    </Grid>
</UserControl>
