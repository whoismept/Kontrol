<UserControl x:Class="Kontrol.Views.FanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:Kontrol.Converters"
             xmlns:vm="clr-namespace:Kontrol.ViewModels">

    <UserControl.Resources>
        <conv:TemperatureToColorConverter x:Key="TempColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:TempCriticalConverter x:Key="TempCritical"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="32,24,32,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Gauge24" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Hardware Monitoring" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.55"/>
                </StackPanel>
            </StackPanel>
            <ui:Button Command="{Binding RefreshReadingsCommand}"
                       Appearance="Secondary"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                       ToolTip="Refresh"/>
        </Grid>

        <!-- Loading overlay -->
        <ui:ProgressRing Grid.Row="1"
                         IsIndeterminate="True"
                         Width="32" Height="32"
                         VerticalAlignment="Top" HorizontalAlignment="Center"
                         Margin="0,8,0,0"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,24">
            <StackPanel>

                <!-- Temperatures -->
                <TextBlock Text="Temperaturelar" FontSize="11" FontWeight="SemiBold"
                           Opacity="0.5" Margin="0,8,0,10"/>

                <ItemsControl ItemsSource="{Binding TemperatureGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SensorGroup}">
                            <ui:CardExpander Margin="0,0,0,8" IsExpanded="True">
                                <ui:CardExpander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Temperature24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding HardwareName}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:CardExpander.Header>
                                <ItemsControl ItemsSource="{Binding Sensors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="TempCard" Margin="4" Padding="14,10" CornerRadius="8"
                                                    Width="148"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderThickness="0,0,0,2"
                                                    BorderBrush="{Binding Value, Converter={StaticResource TempColor}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SensorName}"
                                                               FontSize="11"
                                                               Opacity="0.6"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DisplayValue}"
                                                               FontSize="22" FontWeight="Bold"
                                                               Foreground="{Binding Value, Converter={StaticResource TempColor}}"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Value, Converter={StaticResource TempCritical}}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="PulseStory">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetName="TempCard"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 From="1.0" To="0.55" Duration="0:0:0.6"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="PulseStory"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ui:CardExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Fan Speeds -->
                <TextBlock Text="Fan Speeds" FontSize="11" FontWeight="SemiBold"
                           Opacity="0.5" Margin="0,24,0,10"/>

                <ItemsControl ItemsSource="{Binding FanGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SensorGroup}">
                            <ui:CardExpander Margin="0,0,0,8" IsExpanded="True">
                                <ui:CardExpander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="WeatherBlowingSnow24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding HardwareName}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:CardExpander.Header>
                                <ItemsControl ItemsSource="{Binding Sensors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="4" Padding="14,10" CornerRadius="8"
                                                    Width="160"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="WeatherBlowingSnow24"
                                                                       FontSize="12" Margin="0,0,5,0"
                                                                       VerticalAlignment="Center" Opacity="0.5"/>
                                                        <TextBlock Text="{Binding SensorName}"
                                                                   FontSize="11" Opacity="0.6"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DisplayValue}"
                                                               FontSize="20" FontWeight="Bold"
                                                               Margin="0,4,0,0"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ui:CardExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Loads -->
                <TextBlock Text="Loadr" FontSize="11" FontWeight="SemiBold"
                           Opacity="0.5" Margin="0,24,0,10"/>

                <ItemsControl ItemsSource="{Binding LoadGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SensorGroup}">
                            <ui:Card Margin="0,0,0,8" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="{Binding HardwareName}"
                                               FontWeight="SemiBold" FontSize="13"
                                               Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding Sensors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="56"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding SensorName}"
                                                               VerticalAlignment="Center" FontSize="12" Opacity="0.8"/>
                                                    <ProgressBar Grid.Column="1"
                                                                 Value="{Binding Value}"
                                                                 Maximum="100"
                                                                 Height="5"
                                                                 VerticalAlignment="Center"
                                                                 Margin="8,0"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding DisplayValue}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
