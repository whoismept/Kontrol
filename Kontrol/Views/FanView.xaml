<UserControl x:Class="Kontrol.Views.FanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:Kontrol.Converters"
             xmlns:vm="clr-namespace:Kontrol.ViewModels">

    <UserControl.Resources>
        <conv:TemperatureToColorConverter x:Key="TempColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:TempCriticalConverter x:Key="TempCritical"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="32,24,32,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Gauge24" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="Donanım İzleme"
                           FontSize="28" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <ui:Button Command="{Binding RefreshReadingsCommand}"
                       Appearance="Secondary"
                       HorizontalAlignment="Right"
                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                       ToolTip="Yenile"/>
        </Grid>

        <!-- Loading -->
        <ui:ProgressRing Grid.Row="1"
                         IsIndeterminate="True"
                         Width="32" Height="32"
                         VerticalAlignment="Top" HorizontalAlignment="Center"
                         Margin="0,8,0,0"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="32,0,32,16">
            <StackPanel>

                <!-- Temperatures Section -->
                <TextBlock Text="Sıcaklıklar" FontSize="16" FontWeight="SemiBold"
                           Margin="0,8,0,12"/>

                <ItemsControl ItemsSource="{Binding TemperatureGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SensorGroup}">
                            <ui:CardExpander Margin="0,0,0,8" IsExpanded="True">
                                <ui:CardExpander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Temperature24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding HardwareName}"
                                                   FontWeight="SemiBold" FontSize="14"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:CardExpander.Header>
                                <ItemsControl ItemsSource="{Binding Sensors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="TempCard" Margin="4" Padding="16,12" CornerRadius="8"
                                                    Width="160"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderThickness="0,0,0,3"
                                                    BorderBrush="{Binding Value, Converter={StaticResource TempColor}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SensorName}"
                                                               FontSize="12"
                                                               Opacity="0.7"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DisplayValue}"
                                                               FontSize="24" FontWeight="Bold"
                                                               Foreground="{Binding Value, Converter={StaticResource TempColor}}"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Value, Converter={StaticResource TempCritical}}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="PulseStory">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetName="TempCard"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 From="1.0" To="0.6" Duration="0:0:0.6"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="PulseStory"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ui:CardExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Fan Speeds -->
                <TextBlock Text="Fan Hızları" FontSize="16" FontWeight="SemiBold"
                           Margin="0,24,0,12"/>

                <ItemsControl ItemsSource="{Binding FanGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SensorGroup}">
                            <ui:CardExpander Margin="0,0,0,8" IsExpanded="True">
                                <ui:CardExpander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="WeatherBlowingSnow24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding HardwareName}"
                                                   FontWeight="SemiBold" FontSize="14"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:CardExpander.Header>
                                <ItemsControl ItemsSource="{Binding Sensors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="4" Padding="16,12" CornerRadius="8"
                                                    Width="170"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="WeatherBlowingSnow24"
                                                                       FontSize="14" Margin="0,0,4,0"
                                                                       VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding SensorName}"
                                                                   FontSize="12" Opacity="0.7"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DisplayValue}"
                                                               FontSize="20" FontWeight="Bold"
                                                               Margin="0,6,0,0"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ui:CardExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Loads -->
                <TextBlock Text="Yükler" FontSize="16" FontWeight="SemiBold"
                           Margin="0,24,0,12"/>

                <ItemsControl ItemsSource="{Binding LoadGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SensorGroup}">
                            <ui:Card Margin="0,0,0,8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="{Binding HardwareName}"
                                               FontWeight="SemiBold" FontSize="14"
                                               Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding Sensors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="60"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding SensorName}"
                                                               VerticalAlignment="Center" FontSize="12"/>
                                                    <ProgressBar Grid.Column="1"
                                                                 Value="{Binding Value}"
                                                                 Maximum="100"
                                                                 Height="6"
                                                                 VerticalAlignment="Center"
                                                                 Margin="8,0"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding DisplayValue}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Padding="32,8">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="11" Opacity="0.7"/>
        </Border>
    </Grid>
</UserControl>
