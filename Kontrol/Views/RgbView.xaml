<UserControl x:Class="Kontrol.Views.RgbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:Kontrol.Converters"
             xmlns:models="clr-namespace:Kontrol.Models">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:ColorToSolidBrushConverter x:Key="ColorToBrush"/>
        <conv:RgbBackendLabelConverter x:Key="BackendLabel"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="32,24,32,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Color24" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="RGB Kontrolü" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Native LampArray + vendor SDK destekli çok-katmanlı RGB kontrolü"
                               FontSize="12" Opacity="0.7"/>
                </StackPanel>
            </StackPanel>
            <ui:Button Command="{Binding LoadDevicesCommand}"
                       Appearance="Secondary"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                       Content="Yeniden Tara"/>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="32,0,32,16">

            <!-- No devices found -->
            <ScrollViewer Visibility="{Binding HasDevices, Converter={StaticResource InvBoolToVis}}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <ui:Card Padding="24" Margin="0,0,0,16">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Color24" FontSize="40" Opacity="0.4" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                            <TextBlock Text="RGB cihaz bulunamadı" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" LineHeight="20">
                                Uygulama iki yöntemle cihazları tanır:<LineBreak/>
                                <LineBreak/>
                                <Run FontWeight="SemiBold">1. Windows Native (LampArray)</Run>
                                <Run>— Herhangi bir SDK gerektirmez. HID LampArray protokolünü destekleyen cihazları otomatik bulur.</Run>
                                <LineBreak/>
                                <LineBreak/>
                                <Run FontWeight="SemiBold">2. Vendor SDK</Run>
                                <Run>— Aşağıdaki markalara ait cihazlar ilgili yazılım yüklüyse çalışır:</Run>
                            </TextBlock>
                        </StackPanel>
                    </ui:Card>

                    <!-- Vendor table -->
                    <ui:Card Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Desteklenen Vendor SDK'ları" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="ASUS" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Armoury Crate / Aura Sync" Opacity="0.7" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Text="Corsair" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="iCUE" Opacity="0.7" Margin="0,4"/>

                                <TextBlock Grid.Row="2" Text="CoolerMaster" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="MasterPlus+" Opacity="0.7" Margin="0,4"/>

                                <TextBlock Grid.Row="3" Text="Logitech" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="G HUB" Opacity="0.7" Margin="0,4"/>

                                <TextBlock Grid.Row="4" Text="MSI" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="MSI Center / Dragon Center" Opacity="0.7" Margin="0,4"/>

                                <TextBlock Grid.Row="5" Text="Razer" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Razer Synapse" Opacity="0.7" Margin="0,4"/>

                                <TextBlock Grid.Row="6" Text="SteelSeries" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="SteelSeries GG" Opacity="0.7" Margin="0,4"/>

                                <TextBlock Grid.Row="7" Text="Wooting" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="Direkt HID (yazılım gerekmez)" Opacity="0.7" Margin="0,4"/>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- Init log summary -->
                    <ui:Card Padding="20">
                        <StackPanel>
                            <TextBlock Text="Başlatma Özeti" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding InitLogText}" FontSize="12" Opacity="0.75" Margin="0,0,0,8"/>
                            <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap">
                                Yeniden Tara düğmesine basarak cihazları tekrar tarayabilirsiniz.
                                Vendor yazılımını yükledikten sonra uygulamayı yeniden başlatın.
                            </TextBlock>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- Devices + ColorPicker -->
            <Grid Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="220"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Device list -->
                <ui:Card Grid.Column="0" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Cihazlar" FontWeight="SemiBold" FontSize="14"
                                   Margin="16,12,16,8"/>
                        <ListBox ItemsSource="{Binding Devices}"
                                 SelectedItem="{Binding SelectedDevice}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="8,0,8,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="10" Height="10" CornerRadius="5"
                                                VerticalAlignment="Top" Margin="0,4,0,0"
                                                Background="{Binding CurrentColor, Converter={StaticResource ColorToBrush}}"/>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} · {1} LED · {2}">
                                                        <Binding Path="Type"/>
                                                        <Binding Path="LedCount"/>
                                                        <Binding Path="Backend" Converter="{StaticResource BackendLabel}"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </ui:Card>

                <!-- Color editor -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <ui:Card Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Renk Seç" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>

                                <!-- Color preview -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="56" Height="56" CornerRadius="10"
                                            Background="{Binding SelectedColor, Converter={StaticResource ColorToBrush}}"
                                            Margin="0,0,16,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" Opacity="0.3" ShadowDepth="3"/>
                                        </Border.Effect>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Seçili Renk" FontSize="11" Opacity="0.7"/>
                                        <TextBlock FontSize="16" FontWeight="Bold">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="#{0:X2}{1:X2}{2:X2}">
                                                    <Binding Path="SelectedColor.R"/>
                                                    <Binding Path="SelectedColor.G"/>
                                                    <Binding Path="SelectedColor.B"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Sliders -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="R" Foreground="#F44336" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Value="{Binding SelectedColor.R}"
                                            Minimum="0" Maximum="255" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SelectedColor.R}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>

                                    <TextBlock Grid.Row="2" Text="G" Foreground="#4CAF50" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="2" Grid.Column="1" Value="{Binding SelectedColor.G}"
                                            Minimum="0" Maximum="255" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SelectedColor.G}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>

                                    <TextBlock Grid.Row="4" Text="B" Foreground="#2196F3" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="4" Grid.Column="1" Value="{Binding SelectedColor.B}"
                                            Minimum="0" Maximum="255" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding SelectedColor.B}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                                </Grid>

                                <!-- Presets -->
                                <TextBlock Text="Hazır Renkler" FontSize="11" Opacity="0.7" Margin="0,18,0,8"/>
                                <WrapPanel>
                                    <Button Click="OnPresetColorClick" Tag="#FF0000" Width="34" Height="34" Margin="2"
                                            Padding="0" Background="Transparent" BorderThickness="0">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#FF0000"/>
                                    </Button>
                                    <Button Click="OnPresetColorClick" Tag="#00FF00" Width="34" Height="34" Margin="2"
                                            Padding="0" Background="Transparent" BorderThickness="0">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#00FF00"/>
                                    </Button>
                                    <Button Click="OnPresetColorClick" Tag="#0000FF" Width="34" Height="34" Margin="2"
                                            Padding="0" Background="Transparent" BorderThickness="0">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#0000FF"/>
                                    </Button>
                                    <Button Click="OnPresetColorClick" Tag="#FF00FF" Width="34" Height="34" Margin="2"
                                            Padding="0" Background="Transparent" BorderThickness="0">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#FF00FF"/>
                                    </Button>
                                    <Button Click="OnPresetColorClick" Tag="#00FFFF" Width="34" Height="34" Margin="2"
                                            Padding="0" Background="Transparent" BorderThickness="0">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#00FFFF"/>
                                    </Button>
                                    <Button Click="OnPresetColorClick" Tag="#FFFF00" Width="34" Height="34" Margin="2"
                                            Padding="0" Background="Transparent" BorderThickness="0">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#FFFF00"/>
                                    </Button>
                                    <Button Click="OnPresetColorClick" Tag="#FF8000" Width="34" Height="34" Margin="2"
                                            Padding="0" Background="Transparent" BorderThickness="0">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#FF8000"/>
                                    </Button>
                                    <Button Click="OnPresetColorClick" Tag="#FFFFFF" Width="34" Height="34" Margin="2"
                                            Padding="0" Background="Transparent" BorderThickness="0">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#FFFFFF"
                                                BorderBrush="#888" BorderThickness="1"/>
                                    </Button>
                                    <Button Click="OnPresetColorClick" Tag="#000000" Width="34" Height="34" Margin="2"
                                            Padding="0" Background="Transparent" BorderThickness="0">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#000000"
                                                BorderBrush="#888" BorderThickness="1"/>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- Apply -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <ui:Button Command="{Binding ApplyColorToDeviceCommand}"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon Lightbulb24}"
                                       Content="Seçili Cihaza Uygula"
                                       Margin="0,0,8,0"/>
                            <ui:Button Command="{Binding ApplyColorToAllCommand}"
                                       Appearance="Secondary"
                                       Icon="{ui:SymbolIcon Lightbulb24}"
                                       Content="Tüm Cihazlara Uygula"/>
                        </StackPanel>

                        <!-- Profiles -->
                        <ui:Card Padding="20">
                            <StackPanel>
                                <TextBlock Text="Profiller" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <ComboBox ItemsSource="{Binding Profiles}"
                                              SelectedItem="{Binding SelectedProfile}"
                                              Width="220" Margin="0,0,8,0"/>
                                    <ui:Button Command="{Binding LoadProfileCommand}"
                                               Appearance="Secondary"
                                               Icon="{ui:SymbolIcon FolderOpen24}"
                                               Content="Yükle"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="Yeni profil adı"
                                                Width="220" Margin="0,0,8,0"/>
                                    <ui:Button Command="{Binding SaveProfileCommand}"
                                               Appearance="Primary"
                                               Icon="{ui:SymbolIcon Save24}"
                                               Content="Kaydet"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Padding="32,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.7"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock FontSize="11" Opacity="0.5" Margin="0,0,12,0"
                               Text="{Binding InitLogText}"/>
                    <TextBlock FontSize="11" Opacity="0.7">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} cihaz">
                                <Binding Path="Devices.Count"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
