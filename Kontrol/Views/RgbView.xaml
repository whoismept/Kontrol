<UserControl x:Class="Kontrol.Views.RgbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:Kontrol.Converters"
             xmlns:models="clr-namespace:Kontrol.Models">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:ColorToSolidBrushConverter x:Key="ColorToBrush"/>
        <conv:RgbBackendLabelConverter x:Key="BackendLabel"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="32,24,32,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Color24" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="RGB Kontrolü" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.55"/>
                </StackPanel>
            </StackPanel>
            <ui:Button Command="{Binding LoadDevicesCommand}"
                       Appearance="Secondary"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                       ToolTip="Yeniden Tara"/>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="32,0,32,24">

            <!-- No devices found -->
            <ScrollViewer Visibility="{Binding HasDevices, Converter={StaticResource InvBoolToVis}}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                    <ui:Card Padding="24" Margin="0,0,0,12">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Color24" FontSize="36" Opacity="0.35" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                            <TextBlock Text="RGB cihaz bulunamadı" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" LineHeight="20" FontSize="13">
                                Uygulama iki yöntemle cihazları tanır:<LineBreak/>
                                <LineBreak/>
                                <Run FontWeight="SemiBold">1. Windows Native (LampArray)</Run>
                                <Run>— Herhangi bir SDK gerektirmez. HID LampArray protokolünü destekleyen cihazları otomatik bulur.</Run>
                                <LineBreak/>
                                <LineBreak/>
                                <Run FontWeight="SemiBold">2. Vendor SDK</Run>
                                <Run>— Aşağıdaki markalara ait cihazlar ilgili yazılım yüklüyse çalışır.</Run>
                            </TextBlock>
                        </StackPanel>
                    </ui:Card>

                    <!-- Vendor table -->
                    <ui:Card Padding="20" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Desteklenen Vendor SDK'ları" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="ASUS" FontWeight="SemiBold" FontSize="12" Margin="0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Armoury Crate / Aura Sync" Opacity="0.65" FontSize="12" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Text="Corsair" FontWeight="SemiBold" FontSize="12" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="iCUE" Opacity="0.65" FontSize="12" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Text="CoolerMaster" FontWeight="SemiBold" FontSize="12" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="MasterPlus+" Opacity="0.65" FontSize="12" Margin="0,3"/>
                                <TextBlock Grid.Row="3" Text="Logitech" FontWeight="SemiBold" FontSize="12" Margin="0,3"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="G HUB" Opacity="0.65" FontSize="12" Margin="0,3"/>
                                <TextBlock Grid.Row="4" Text="MSI" FontWeight="SemiBold" FontSize="12" Margin="0,3"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="MSI Center / Dragon Center" Opacity="0.65" FontSize="12" Margin="0,3"/>
                                <TextBlock Grid.Row="5" Text="Razer" FontWeight="SemiBold" FontSize="12" Margin="0,3"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Razer Synapse" Opacity="0.65" FontSize="12" Margin="0,3"/>
                                <TextBlock Grid.Row="6" Text="SteelSeries" FontWeight="SemiBold" FontSize="12" Margin="0,3"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="SteelSeries GG" Opacity="0.65" FontSize="12" Margin="0,3"/>
                                <TextBlock Grid.Row="7" Text="Wooting" FontWeight="SemiBold" FontSize="12" Margin="0,3"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="Direkt HID (yazılım gerekmez)" Opacity="0.65" FontSize="12" Margin="0,3"/>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- Init log -->
                    <ui:Card Padding="18">
                        <StackPanel>
                            <TextBlock Text="Başlatma Özeti" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding InitLogText}" FontSize="12" Opacity="0.7" Margin="0,0,0,6"/>
                            <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap">
                                Vendor yazılımını yükledikten sonra uygulamayı yeniden başlatın.
                            </TextBlock>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- Devices + ColorPicker -->
            <Grid Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="200"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Device list -->
                <ui:Card Grid.Column="0" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Cihazlar" FontWeight="SemiBold" FontSize="13"
                                   Margin="16,14,16,8"/>
                        <Border DockPanel.Dock="Top" Height="1"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                Margin="0,0,0,4"/>
                        <ListBox ItemsSource="{Binding Devices}"
                                 SelectedItem="{Binding SelectedDevice}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="6,0,6,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="14" Height="14" CornerRadius="7"
                                                VerticalAlignment="Center"
                                                Background="{Binding CurrentColor, Converter={StaticResource ColorToBrush}}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" Opacity="0.5" ShadowDepth="0"/>
                                            </Border.Effect>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} · {1} LED · {2}">
                                                        <Binding Path="Type"/>
                                                        <Binding Path="LedCount"/>
                                                        <Binding Path="Backend" Converter="{StaticResource BackendLabel}"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </ui:Card>

                <!-- Color editor -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Color picker card -->
                        <ui:Card Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Preview + hex -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="80" Height="80" CornerRadius="12"
                                            Background="{Binding SelectedColor, Converter={StaticResource ColorToBrush}}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" Opacity="0.35" ShadowDepth="4"/>
                                        </Border.Effect>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="HEX" FontSize="10" Opacity="0.55" Margin="0,0,0,4"/>
                                        <ui:TextBox Text="{Binding HexColorText, UpdateSourceTrigger=LostFocus}"
                                                    FontSize="18" FontWeight="SemiBold"
                                                    FontFamily="Consolas"
                                                    PlaceholderText="#RRGGBB"/>
                                        <TextBlock FontSize="10" Opacity="0.45" Margin="0,4,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="R:{0}  G:{1}  B:{2}">
                                                    <Binding Path="SelectedColor.R"/>
                                                    <Binding Path="SelectedColor.G"/>
                                                    <Binding Path="SelectedColor.B"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <!-- RGB sliders -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="R" Foreground="#EF5350" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Value="{Binding SelectedColor.R}"
                                            Minimum="0" Maximum="255" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SelectedColor.R}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>

                                    <TextBlock Grid.Row="2" Text="G" Foreground="#66BB6A" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="2" Grid.Column="1" Value="{Binding SelectedColor.G}"
                                            Minimum="0" Maximum="255" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SelectedColor.G}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>

                                    <TextBlock Grid.Row="4" Text="B" Foreground="#42A5F5" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="4" Grid.Column="1" Value="{Binding SelectedColor.B}"
                                            Minimum="0" Maximum="255" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding SelectedColor.B}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
                                </Grid>

                                <!-- Presets -->
                                <TextBlock Text="Hazır Renkler" FontSize="11" Opacity="0.55" Margin="0,20,0,8"/>
                                <WrapPanel>
                                    <Button Click="OnPresetColorClick" Tag="#FF0000" Width="40" Height="40" Margin="3"
                                            Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#FF0000">
                                            <Border.Effect><DropShadowEffect BlurRadius="6" Opacity="0.5" ShadowDepth="0"/></Border.Effect>
                                        </Border>
                                    </Button>
                                    <Button Click="OnPresetColorClick" Tag="#FF6600" Width="40" Height="40" Margin="3"
                                            Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#FF6600">
                                            <Border.Effect><DropShadowEffect BlurRadius="6" Opacity="0.5" ShadowDepth="0"/></Border.Effect>
                                        </Border>
                                    </Button>
                                    <Button Click="OnPresetColorClick" Tag="#FFFF00" Width="40" Height="40" Margin="3"
                                            Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#FFFF00">
                                            <Border.Effect><DropShadowEffect BlurRadius="6" Opacity="0.5" ShadowDepth="0"/></Border.Effect>
                                        </Border>
                                    </Button>
                                    <Button Click="OnPresetColorClick" Tag="#00FF00" Width="40" Height="40" Margin="3"
                                            Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#00FF00">
                                            <Border.Effect><DropShadowEffect BlurRadius="6" Opacity="0.5" ShadowDepth="0"/></Border.Effect>
                                        </Border>
                                    </Button>
                                    <Button Click="OnPresetColorClick" Tag="#00FFFF" Width="40" Height="40" Margin="3"
                                            Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#00FFFF">
                                            <Border.Effect><DropShadowEffect BlurRadius="6" Opacity="0.5" ShadowDepth="0"/></Border.Effect>
                                        </Border>
                                    </Button>
                                    <Button Click="OnPresetColorClick" Tag="#0000FF" Width="40" Height="40" Margin="3"
                                            Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#0000FF">
                                            <Border.Effect><DropShadowEffect BlurRadius="6" Opacity="0.5" ShadowDepth="0"/></Border.Effect>
                                        </Border>
                                    </Button>
                                    <Button Click="OnPresetColorClick" Tag="#FF00FF" Width="40" Height="40" Margin="3"
                                            Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#FF00FF">
                                            <Border.Effect><DropShadowEffect BlurRadius="6" Opacity="0.5" ShadowDepth="0"/></Border.Effect>
                                        </Border>
                                    </Button>
                                    <Button Click="OnPresetColorClick" Tag="#FFFFFF" Width="40" Height="40" Margin="3"
                                            Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#FFFFFF"
                                                BorderBrush="#66888888" BorderThickness="1.5"/>
                                    </Button>
                                    <Button Click="OnPresetColorClick" Tag="#888888" Width="40" Height="40" Margin="3"
                                            Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#888888">
                                            <Border.Effect><DropShadowEffect BlurRadius="6" Opacity="0.3" ShadowDepth="0"/></Border.Effect>
                                        </Border>
                                    </Button>
                                    <Button Click="OnPresetColorClick" Tag="#000000" Width="40" Height="40" Margin="3"
                                            Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#000000"
                                                BorderBrush="#66888888" BorderThickness="1.5"/>
                                    </Button>
                                </WrapPanel>

                                <!-- Apply buttons -->
                                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,20,0,16"/>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Command="{Binding ApplyColorToDeviceCommand}"
                                               Appearance="Primary"
                                               Icon="{ui:SymbolIcon Lightbulb24}"
                                               Content="Seçili Cihaza Uygula"
                                               Margin="0,0,8,0"/>
                                    <ui:Button Command="{Binding ApplyColorToAllCommand}"
                                               Appearance="Secondary"
                                               Icon="{ui:SymbolIcon Lightbulb24}"
                                               Content="Tümüne Uygula"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- Profiles -->
                        <ui:Card Padding="20">
                            <StackPanel>
                                <TextBlock Text="Profiller" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ComboBox ItemsSource="{Binding Profiles}"
                                              SelectedItem="{Binding SelectedProfile}"
                                              Width="200" Margin="0,0,8,0"/>
                                    <ui:Button Command="{Binding LoadProfileCommand}"
                                               Appearance="Secondary"
                                               Icon="{ui:SymbolIcon FolderOpen24}"
                                               Content="Yükle"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="Yeni profil adı"
                                                Width="200" Margin="0,0,8,0"/>
                                    <ui:Button Command="{Binding SaveProfileCommand}"
                                               Appearance="Primary"
                                               Icon="{ui:SymbolIcon Save24}"
                                               Content="Kaydet"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
