<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004 (19041) target enables WinRT APIs (LampArray, etc.) without extra packages -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Kontrol</AssemblyTitle>
    <Product>Kontrol</Product>
    <Copyright>2026 Mert Umut</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RootNamespace>Kontrol</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="RGB.NET.Core" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Devices.Asus" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Devices.CoolerMaster" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Devices.Corsair" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Devices.Logitech" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Devices.Msi" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Devices.OpenRGB" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Devices.Razer" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Devices.SteelSeries" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Devices.Wooting" Version="3.2.0" />
    <PackageReference Include="WPF-UI" Version="4.2.1" />
  </ItemGroup>

</Project>
